# YCode needs no API key: it answers with its own built-in model (YCode-LM).
# Copy this file to .env (or ~/.ycode/.env) only to change settings. Never commit .env.

# Which built-in model to use: v2, v3, v4, v5 (default) or a model directory.
YCODE_LOCAL_MODEL=

# Optional, only for Claude (`ycode --provider anthropic`, after `pip install -e ".[claude]"`):
# ANTHROPIC_API_KEY=
# YCODE_MODEL=claude-opus-5-5
